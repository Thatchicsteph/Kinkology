{
	email admin@ChangeMe
}

# Shared routing: /api/* (incl. WebSockets) -> backend, everything else -> SPA
(app) {
	handle /api/* {
		reverse_proxy backend:8001
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Public HTTPS via Let's Encrypt. Domain comes from the DOMAIN env var
# (set it in .env). Requires router port-forwards: 80 -> Mac and 443 -> Mac.
{$DOMAIN:ChangeMe} {
	import app
}

# Local owner access on the Mac: http://localhost
http://localhost {
	import app
}
