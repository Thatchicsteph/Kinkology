# Copy this file to ".env" in the project root before starting the stack:
#   cp env.docker.example .env
#
# Then build & run everything:
#   docker compose up -d --build
#
# JWT_SECRET signs the owner login tokens. Keep it private.
# REQUIRED: generate your own and paste it here (the app refuses to start otherwise):
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Public domain Caddy requests an HTTPS certificate for (Let's Encrypt).
# This is your GLOBAL address for remote guests. Ports 80 & 443 must reach the Mac.
DOMAIN=tg30.ddns.net

# CORS: leave UNSET for the standard single-origin setup (frontend + /api served by
# the same Caddy). Only set this to a comma-separated allowlist of origins if you serve
# the frontend from a different domain than the backend.
# CORS_ORIGINS=https://tg30.ddns.net
