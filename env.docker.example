# Copy this file to ".env" in the project root before starting the stack:
#   cp env.docker.example .env
#
# Then build & run everything:
#   docker compose up -d --build
#
# JWT_SECRET signs the owner login tokens. Keep it private.
# REQUIRED: generate your own and paste it here (the app refuses to start otherwise):
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# Public domain Caddy requests an HTTPS certificate for (Let's Encrypt).
# This is your GLOBAL address for remote guests. Ports 80 & 443 must reach the Mac.
DOMAIN=ChangeMe

# CORS: leave UNSET for the standard single-origin setup (frontend + /api served by
# the same Caddy). Only set this to a comma-separated allowlist of origins if you serve
# the frontend from a different domain than the backend.
# CORS_ORIGINS=https://ChangeMe

# --- OBS live stream (WHIP) ------------------------------------------------
# WebRTC needs a UDP port range that OBS can reach on the host. Defaults work
# for OBS running on the SAME Mac as Docker. Override only if 50000..50019 is
# taken, or if OBS runs on another machine on your LAN / over the internet.
#
# STREAM_UDP_MIN=50000
# STREAM_UDP_MAX=50019
#
# The IP the backend advertises to OBS in ICE candidates. Must be an address
# OBS can reach.
#   - OBS on same Mac as Docker: 127.0.0.1 (default)
#   - OBS on another machine on your LAN: set to the Mac's LAN IP, e.g. 192.168.1.42
#   - Remote OBS: set to your public IP or DDNS host (e.g. tg30.ddns.net) and
#     make sure your router forwards the UDP range above to the Mac.
# STREAM_PUBLIC_IP=127.0.0.1
#
# The address the backend uses to send ICE checks BACK to OBS. On Docker
# Desktop this must be host.docker.internal so packets escape the bridge net.
# Leave this alone unless you know what you're doing.
# STREAM_PEER_IP=host.docker.internal

# --- WebRTC ICE servers (mobile / cross-network viewers) -------------------
# STUN lets the backend discover its public IP so mobile clients on 4G/5G or
# foreign networks can complete ICE. The default (Google + Cloudflare public
# STUN) is fine for almost everyone — only override if you need private STUN.
# STREAM_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
#
# TURN is a relay used when direct WebRTC fails, e.g. mobile carriers on
# symmetric NAT / CGNAT. Without it, phones on 4G/5G may see a black screen.
# EASY OPTION: use the built-in Cloudflare Calls TURN one-click setup — sign
# in as admin, open the "Cloudflare TURN" card, paste your TURN Key ID + API
# Token from dash.cloudflare.com → Realtime → TURN. Free 1000 GB/mo.
# ADVANCED OPTION (self-hosted or non-Cloudflare TURN): set the vars below.
# STREAM_TURN_URL=turn:turn.example.com:3478
# STREAM_TURN_USERNAME=your-username
# STREAM_TURN_PASSWORD=your-password

# Cloudflare TURN credentials are stored Fernet-encrypted in Mongo. Generate
# a persistent key ONCE with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"` and put it here. If left unset the
# backend generates an ephemeral key at startup and the saved credentials
# won't survive a restart.
# TURN_CREDENTIAL_ENCRYPTION_KEY=paste-fernet-key-here
